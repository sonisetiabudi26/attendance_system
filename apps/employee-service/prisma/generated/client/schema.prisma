generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id     BigInt  @id @default(autoincrement())
  userId BigInt? @map("user_id")

  employeeNo String  @unique @map("employee_no")
  fullName   String  @map("full_name")
  phone      String?

  photoUrl String? @map("photo_url")

  positionId BigInt @map("position_id")

  isDeleted Boolean @default(false) @map("is_deleted")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  position MasterPosition @relation(fields: [positionId], references: [id])

  employeeLocations EmployeeLocation[]

  @@map("employees")
}

model MasterPosition {
  id BigInt @id @default(autoincrement())

  code String @unique

  name String

  createdBy BigInt? @map("created_by")

  updatedBy BigInt? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@map("master_positions")
}

model Location {
  id BigInt @id @default(autoincrement())

  locationName String @map("location_name")

  address String?

  latitude Decimal? @db.Decimal(10, 7)

  longitude Decimal? @db.Decimal(10, 7)

  radius Int

  createdBy BigInt? @map("created_by")

  updatedBy BigInt? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  employeeLocations EmployeeLocation[]

  @@map("locations")
}

model EmployeeLocation {
  id BigInt @id @default(autoincrement())

  employeeId BigInt @map("employee_id")

  locationId BigInt @map("location_id")

  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  location Location @relation(fields: [locationId], references: [id])

  @@unique([employeeId, locationId])
  @@map("employee_locations")
}
